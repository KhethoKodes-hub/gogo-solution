{
  "name": "@go-go-shuttles-platform/source",
  "version": "2.0.0",
  "description": "GoGo Shuttles Monorepo Solution with API and back office",
  "license": "MIT",
  "scripts": {
    "api:build": "npx nx build api",
    "api:serve": "npx nx serve api",
    "api:test": "npx nx test api",
    "frontend:build": "npx nx build frontend",
    "frontend:serve": "npx nx serve frontend",
    "frontend:start": "npx nx start frontend",
    "dev": "npx nx run-many --target=serve --projects=api,frontend --parallel=2",
    "build": "npx nx run-many --target=build --projects=api,frontend",
    "db:up": "docker compose up -d mariadb",
    "db:down": "docker compose stop mariadb",
    "db:seed": "node scripts/seed-local.cjs"
  },
  "private": true,
