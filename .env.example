# API
PORT=3000
ALLOWED_ORIGIN=http://localhost:4200

# MariaDB (MySQL-compatible)
# If API runs on host machine, use 127.0.0.1.
# If API runs in Docker Compose, use service name: mariadb.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gogo_app
DB_PASSWORD=gogo_app_pw
# Optional for native/local auth via unix socket (common on macOS).
# Example: /tmp/mysql.sock
DB_SOCKET_PATH=
DB_NAME=gogo_shuttles_platform
DB_SYNC=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-too
JWT_REFRESH_TTL=7d

# Auth mode
AUTH_DISABLED=false

# Local-dev fallback m2m client (used if DB client record is not found)
M2M_DEV_CLIENT_ID=local-bff
M2M_DEV_CLIENT_SECRET=local-dev-secret-please-change
M2M_DEV_SCOPES=api.read api.write

# Frontend runtime
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Contact/email
CONTACT_EMAIL_MODE=log
CONTACT_NOTIFICATION_EMAIL=ops@gogoshuttles.local
MAIL_FROM=noreply@gogoshuttles.local
MAIL_REPLY_TO=ops@gogoshuttles.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PDF generation (Puppeteer) for payment receipts and quote estimates
# Set to false if running on a host/container that provides its own sandboxing
# (e.g. gVisor, or Chrome installed with setuid sandbox support).
PDF_NO_SANDBOX=true

# Booking EFT details shown in booking emails
EFT_BENEFICIARY=GO-GO Shuttles (Pty) Ltd
EFT_BANK=FNB
EFT_ACCOUNT_NUMBER=62715804119
EFT_ACCOUNT_TYPE=Cheque Account
EFT_BRANCH_CODE=250 655 (South Gate)
EFT_PROOF_EMAIL=info@gogoshuttles.co.za

# PayFast
PAYFAST_ENABLED=false
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_VALIDATE_ITN=true
FRONTEND_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:3001
# Optional explicit callback routes (defaults are derived from FRONTEND_BASE_URL/API_PUBLIC_BASE_URL)
# PAYFAST_RETURN_URL=http://localhost:3000/booking?payment=success
# PAYFAST_CANCEL_URL=http://localhost:3000/booking?payment=cancelled
# PAYFAST_NOTIFY_URL=http://localhost:3001/api/bookings/payfast/itn

# Optional recaptcha verification
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=contact_submit

# Quote estimate behavior
# table: derive from wp_route/wp_price using route+capacity (default)
# legacy-formula: WP-style base+distance+day+trailer formula when all required fields are supplied
QUOTE_ESTIMATE_MODE=table

# Docker Compose overrides (optional)
# Uncomment when running API inside docker-compose.
# DB_HOST=mariadb

# Optional seed overrides
SEED_DEMO_USER_EMAIL=demo@gogoshuttles.local
SEED_DEMO_USER_PASSWORD=DemoPass123!
