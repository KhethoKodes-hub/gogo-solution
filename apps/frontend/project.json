{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/app",
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nuxi build",
        "cwd": "apps/frontend",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nuxi dev",
        "cwd": "apps/frontend"
      }
    },
    "start": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node .output/server/index.mjs",
        "cwd": "apps/frontend",
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
